[Unit]
Description=SSHUI Lite - web editor for the SSH client config (~/.ssh/config)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /opt/sshui/app.py
Environment=SSHUI_HOST=127.0.0.1 SSHUI_PORT=8787 SSHUI_CONFIG=/root/.ssh/config
Restart=on-failure
RestartSec=2
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/.ssh /var/lib/sshui
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
